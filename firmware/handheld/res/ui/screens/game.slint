import { Global, ScreenId, Backend } from "../common.slint";
import { ScreenBase } from "../components/screen.slint";
import { Button } from "../components/button.slint";
import { ButtonList } from "../components/button_list.slint";
import { CoreSettingList } from "cores/core_settings.slint";
import { CoreSettingType } from "cores/types.slint";
import { CoreFileSelect } from "cores/core_file_select.slint";

export component GameScreen inherits ScreenBase {
    private property <bool> menu-open: false;
    private property <bool> settings-open: false;
    // Choosing another disc.
    private property <bool> file-select-open: false;
    private property <[string]> menu-items: Backend.game-can-change-disc
        ? ["Return", "Settings", "Change Disc", "Exit Core"]
        : ["Return", "Settings", "Exit Core"];
    forward-focus: i-focus-scope;

    // /** todo: dev remove */
    // width: 240px;
    // height: 160px;
    // init => {
    //     settings-open = true;
    //     i-settings.focus();
    // }

    protected function set-menu-open(open: bool) {
        Global.ui-status-bar = open;
        Backend.game-set-focused(!open);
        self.menu-open = open;
        if (menu-open) {
            i-list.focus();
        } else {
            settings-open = false;
            file-select-open = false;
            i-focus-scope.focus();
        }
    }

    // The disc has changed: back to the game.
    private property <int> disc-changes: Backend.game-disc-changes;
    changed disc-changes => {
        if (self.menu-open) {
            set-menu-open(false);
        }
    }

    // The power menu takes the focus from the core without opening the
    // pause menu, and gives it back on close unless the pause menu was
    // already open.
    private property <bool> power-menu-open: Global.power-menu-open;
    changed power-menu-open => {
        if (self.power-menu-open) {
            Backend.game-set-focused(false);
        } else if (!self.menu-open) {
            Backend.game-set-focused(true);
        }
    }

    i-focus-scope := FocusScope {
        key-released(event) => {
            if (event.text == "Home" || event.text == "h") && !Global.home-consumed {
                set-menu-open(!root.menu-open);
            }
            if event.text == "b" && settings-open {
                settings-open = false;
                i-list.focus();
            }
            reject
        }

        menu := Rectangle {
            visible: menu-open;
            background: #FFF;
            border-color: black;
            border-width: 1px;
            width: i-list.min-width + 20px;
            height: i-list.min-height;

            i-list := ButtonList {
                items: root.menu-items;
                on-selected(item) => {
                    if (root.menu-items[item] == "Return") {
                        root.set-menu-open(false);
                    } else if (root.menu-items[item] == "Settings") {
                        Backend.game-settings-load();
                        root.settings-open = true;
                    } else if (root.menu-items[item] == "Change Disc") {
                        root.file-select-open = true;
                        Backend.game-change-disc();
                    } else if (root.menu-items[item] == "Exit Core") {
                        Backend.game-exit();
                    }
                }
            }
        }

        settings := Rectangle {
            visible: settings-open;
            background: #FFF;
            border-color: black;
            border-width: 1px;
            x: 32px;
            y: 32px;
            width: root.width - 64px;
            height: root.height - 64px;

            if settings-open: CoreSettingList {
                x: 2px;
                y: 2px;
                width: parent.width - 4px;
                height: parent.height - 4px;
                init => {
                    self.focus();
                }
                // Such as Load State: back to the game.
                resume => {
                    root.set-menu-open(false);
                }
            }
        }

        file-select := Rectangle {
            visible: file-select-open;
            background: #FFF;
            border-color: black;
            border-width: 1px;
            x: 16px;
            y: 16px;
            width: root.width - 32px;
            height: root.height - 32px;

            if file-select-open: CoreFileSelect {
                x: 4px;
                y: 4px;
                width: parent.width - 8px;
                height: parent.height - 8px;
                init => {
                    self.focus();
                }
                on-cancel => {
                    root.file-select-open = false;
                    Backend.core-file-select-cancel();
                    i-list.focus();
                }
            }
        }

        if Backend.core-is-loading:  Rectangle {
            background: #FFF;
            border-color: black;
            border-width: 1px;
            width: i-loading-layout.min-width;
            height: i-loading-layout.min-height;

            i-loading-layout := VerticalLayout {
                padding: 8px;
                spacing: 4px;
                i-text := Text {
                    horizontal-alignment: center;
                    text: "Loading...";
                }

                Rectangle {
                    background: black;
                    width: Backend.core-progress * i-text.min-width;
                    height: 2px;
                }
            }
        }
    }
}
